    </main>
  </div>

  <!-- <footer> : bottom of the page -->
  <footer class="text-center p-4 text-sm text-slate-600">
    <p>&copy; 2026 Parul Wanjari - CD25029 | Web Fundamentals and Basic Frontend Design Lab</p>
  </footer>

</body>
</html>
