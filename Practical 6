<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Grade Calculator</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-indigo-100 font-sans p-5">

  <div class="max-w-md mx-auto my-5 bg-white p-7 rounded-xl shadow-lg">
    <h1 class="text-center text-2xl font-bold text-indigo-800">Student Grade Calculator</h1>
    <p class="text-center text-slate-500 text-sm mb-5">Enter marks out of 100 for each subject</p>

    <label for="name" class="block mt-3 font-bold text-sm">Student Name</label>
    <input type="text" id="name" placeholder="Enter name" class="w-full mt-1 p-2.5 border-2 border-indigo-200 rounded-md">

    <label for="m1" class="block mt-3 font-bold text-sm">Web Fundamentals</label>
    <input type="number" id="m1" placeholder="Marks (0-100)" class="w-full mt-1 p-2.5 border-2 border-indigo-200 rounded-md">
    <label for="m2" class="block mt-3 font-bold text-sm">Python Programming</label>
    <input type="number" id="m2" placeholder="Marks (0-100)" class="w-full mt-1 p-2.5 border-2 border-indigo-200 rounded-md">
    <label for="m3" class="block mt-3 font-bold text-sm">Data Structures</label>
    <input type="number" id="m3" placeholder="Marks (0-100)" class="w-full mt-1 p-2.5 border-2 border-indigo-200 rounded-md">
    <label for="m4" class="block mt-3 font-bold text-sm">Mathematics</label>
    <input type="number" id="m4" placeholder="Marks (0-100)" class="w-full mt-1 p-2.5 border-2 border-indigo-200 rounded-md">
    <label for="m5" class="block mt-3 font-bold text-sm">Indian Constitution</label>
    <input type="number" id="m5" placeholder="Marks (0-100)" class="w-full mt-1 p-2.5 border-2 border-indigo-200 rounded-md">

    <div class="flex gap-2.5 mt-5">
      <button id="calcBtn" class="flex-1 py-3 rounded-md font-bold text-white bg-indigo-600 hover:bg-indigo-800">Calculate</button>
      <button id="resetBtn" class="flex-1 py-3 rounded-md font-bold text-white bg-slate-500 hover:bg-slate-600">Reset</button>
    </div>

    <!-- Validation message appears here -->
    <p id="error" class="text-red-600 text-sm mt-3 min-h-5"></p>

    <!-- Result box: the Tailwind class "hidden" keeps it invisible until marks are valid -->
    <div id="result" class="hidden mt-4 bg-indigo-50 border-l-4 border-indigo-600 p-4 rounded space-y-1.5">
      <p><b>Student:</b> <span id="rName"></span></p>
      <p><b>Total:</b> <span id="rTotal"></span> / 500</p>
      <p><b>Percentage:</b> <span id="rPercent"></span> %</p>
      <p><b>Grade:</b> <span id="rGrade" class="text-2xl font-bold text-green-700"></span></p>
      <p><b>Result:</b> <span id="rStatus"></span></p>
    </div>

    <p class="text-center text-sm text-slate-600 mt-5">Parul Wanjari - CD25029</p>
  </div>

  <script>
    // Get the elements we need
    const ids = ["m1", "m2", "m3", "m4", "m5"];
    const errorBox = document.getElementById("error");
    const resultBox = document.getElementById("result");

    // Make an input look wrong (red) or normal (indigo) by changing Tailwind classes
    function markInvalid(box) {
      box.classList.remove("border-indigo-200");
      box.classList.add("border-red-500", "bg-red-50");
    }
    function markNormal(box) {
      box.classList.remove("border-red-500", "bg-red-50");
      box.classList.add("border-indigo-200");
    }

    // Function to decide grade from percentage
    function getGrade(p) {
      if (p >= 90) return "O (Outstanding)";
      if (p >= 80) return "A+ (Excellent)";
      if (p >= 70) return "A (Very Good)";
      if (p >= 60) return "B (Good)";
      if (p >= 50) return "C (Average)";
      if (p >= 40) return "D (Pass)";
      return "F (Fail)";
    }

    // Runs when the Calculate button is clicked
    document.getElementById("calcBtn").addEventListener("click", function () {
      let total = 0;
      let valid = true;
      errorBox.textContent = "";
      resultBox.classList.add("hidden");

      for (let i = 0; i < ids.length; i++) {
        const box = document.getElementById(ids[i]);
        const value = box.value.trim();
        markNormal(box);

        // Validation: not empty, a number, between 0 and 100
        if (value === "" || isNaN(value) || Number(value) < 0 || Number(value) > 100) {
          markInvalid(box);
          valid = false;
        } else {
          total += Number(value);
        }
      }

      const name = document.getElementById("name").value.trim();
      if (name === "") {
        errorBox.textContent = "Please enter the student name.";
        return;
      }
      if (!valid) {
        errorBox.textContent = "Enter valid marks between 0 and 100 in all subjects (highlighted in red).";
        return;
      }

      // Calculation
      const percentage = (total / 500) * 100;
      const grade = getGrade(percentage);
      const failed = percentage < 40;

      // Show the result on the page
      document.getElementById("rName").textContent = name;
      document.getElementById("rTotal").textContent = total;
      document.getElementById("rPercent").textContent = percentage.toFixed(2);
      document.getElementById("rGrade").textContent = grade;
      document.getElementById("rStatus").textContent = failed ? "FAIL" : "PASS";
      resultBox.classList.remove("hidden");
    });

    // Reset button clears everything
    document.getElementById("resetBtn").addEventListener("click", function () {
      document.getElementById("name").value = "";
      ids.forEach(function (id) {
        const box = document.getElementById(id);
        box.value = "";
        markNormal(box);
      });
      errorBox.textContent = "";
      resultBox.classList.add("hidden");
    });
  </script>
</body>
</html>
