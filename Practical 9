<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Personal To-Do List</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-sky-100 to-indigo-200 min-h-screen font-sans p-4">

  <div class="max-w-lg mx-auto mt-8 bg-white rounded-2xl shadow-xl p-6">
    <h1 class="text-3xl font-bold text-center text-indigo-700">My To-Do List</h1>
    <p class="text-center text-slate-500 text-sm mt-1">Add tasks, tick them when done, delete when not needed</p>

    <!-- Input box + Add button -->
    <div class="flex gap-2 mt-6">
      <input id="taskInput" type="text" placeholder="Enter a new task..."
             class="flex-1 border-2 border-indigo-200 focus:border-indigo-500 outline-none rounded-lg px-4 py-2">
      <button id="addBtn" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 rounded-lg">Add</button>
    </div>
    <!-- Validation message for empty task -->
    <p id="errorMsg" class="text-red-500 text-sm mt-1 h-5"></p>

    <!-- Task list: JavaScript adds <li> items inside this <ul> -->
    <ul id="taskList" class="mt-3 space-y-2"></ul>

    <!-- Counter -->
    <p id="counter" class="text-center text-slate-500 text-sm mt-5"></p>
  </div>

  <p class="text-center text-slate-600 text-sm mt-6">Parul Wanjari - CD25029</p>

  <script>
    const taskInput = document.getElementById("taskInput");
    const addBtn = document.getElementById("addBtn");
    const taskList = document.getElementById("taskList");
    const errorMsg = document.getElementById("errorMsg");
    const counter = document.getElementById("counter");

    // Update the "x of y tasks completed" text
    function updateCounter() {
      const total = taskList.children.length;
      const done = taskList.querySelectorAll(".done").length;
      counter.textContent = total === 0 ? "No tasks yet. Add your first task!" : done + " of " + total + " tasks completed";
    }

    // Create one task item and put it in the list
    function addTask() {
      const text = taskInput.value.trim();

      // Validation: do not allow empty task
      if (text === "") {
        errorMsg.textContent = "Please type a task before adding.";
        return;
      }
      errorMsg.textContent = "";

      // Build the <li> element
      const li = document.createElement("li");
      li.className = "flex items-center gap-3 bg-slate-50 border border-slate-200 rounded-lg px-4 py-3";

      // Checkbox: mark as completed
      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.className = "w-5 h-5 accent-indigo-600";

      // Task text
      const span = document.createElement("span");
      span.textContent = text;
      span.className = "flex-1";

      // Delete button
      const delBtn = document.createElement("button");
      delBtn.textContent = "Delete";
      delBtn.className = "text-sm bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded";

      // When the checkbox changes, add/remove strike-through style
      checkbox.addEventListener("change", function () {
        li.classList.toggle("done", checkbox.checked);
        span.classList.toggle("line-through", checkbox.checked);
        span.classList.toggle("text-slate-400", checkbox.checked);
        updateCounter();
      });

      // When Delete is clicked, remove this task
      delBtn.addEventListener("click", function () {
        li.remove();
        updateCounter();
      });

      li.appendChild(checkbox);
      li.appendChild(span);
      li.appendChild(delBtn);
      taskList.appendChild(li);

      taskInput.value = "";   // clear the input box
      taskInput.focus();
      updateCounter();
    }

    // Add task on button click and also when Enter key is pressed
    addBtn.addEventListener("click", addTask);
    taskInput.addEventListener("keypress", function (e) {
      if (e.key === "Enter") addTask();
    });

    updateCounter();
  </script>
</body>
</html>
